CC = gcc
CFLAGS = -std=c99 -Wall -Wextra -O2
TARGET = sat_solver_c
SOURCES = main_c.c sat_solver_core.c dpll_algorithm.c sudoku_solver_c.c dynamic_arrays.c formula_structures.c
OBJECTS = $(SOURCES:.c=.o)

# 默认目标
all: $(TARGET)

# 构建可执行文件
$(TARGET): $(OBJECTS)
	$(CC) $(CFLAGS) -o $(TARGET) $(OBJECTS) -lm

# 编译对象文件
%.o: %.c sat_solver_c.h
	$(CC) $(CFLAGS) -c $< -o $@

# 清理生成的文件
clean:
	rm -f $(OBJECTS) $(TARGET)

# 调试版本
debug: CFLAGS += -g -DDEBUG
debug: $(TARGET)

# 安装（可选）
install: $(TARGET)
	cp $(TARGET) /usr/local/bin/

# 卸载（可选）
uninstall:
	rm -f /usr/local/bin/$(TARGET)

# 运行测试
test: $(TARGET)
	@echo "运行基本测试..."
	@if [ -f test_simple.cnf ]; then \
		echo "n" | ./$(TARGET) -f test_simple.cnf -v; \
	else \
		echo "测试文件 test_simple.cnf 不存在"; \
	fi

# 性能测试
benchmark: $(TARGET)
	@echo "运行性能对比测试..."
	@if [ -f test_complex.cnf ]; then \
		./$(TARGET) -f test_complex.cnf -c; \
	else \
		echo "测试文件 test_complex.cnf 不存在"; \
	fi

.PHONY: all clean debug install uninstall test benchmark